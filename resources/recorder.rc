#include <windows.h>

// Icono de la aplicacion (lo usan el .exe, la ventana y la bandeja).
IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "recorder_moment"
            VALUE "FileDescription", "Grabador de clips (video + audio)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "recorder"
            VALUE "OriginalFilename", "recorder.exe"
            VALUE "ProductName", "recorder_moment"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
